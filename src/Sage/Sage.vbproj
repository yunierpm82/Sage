<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>True</UseWindowsForms>
    <RootNamespace>Sage</RootNamespace>
    <AssemblyName>Sage</AssemblyName>
    <StartupObject>Sage.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <!-- La integracion con Sage 300 (Sage300BatchImporter.vb) usa el objeto COM "ACCPAC.xapiSession"
       por late binding (Type.GetTypeFromProgID), asi que no necesita ninguna referencia de interop,
       solo que Sage 300 este instalado en la maquina donde corre la app. -->

</Project>
