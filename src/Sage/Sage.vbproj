<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>True</UseWindowsForms>
    <RootNamespace>Sage</RootNamespace>
    <AssemblyName>Sage</AssemblyName>
    <StartupObject>Sage.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Interop de la API COM (Business Logic / Views) de Sage 300, tomado de la instalacion
         local del cliente de Sage 300 2025. Si se compila en otra maquina, ajustar la ruta
         al archivo Interop.AccpacCOMAPI.dll de esa instalacion (normalmente dentro de la
         carpeta de un modulo, ej. GL70A, o en Common Files\Sage). -->
    <Reference Include="Interop.AccpacCOMAPI">
      <HintPath>C:\Program Files (x86)\Sage\Sage300\GL70A\Interop.AccpacCOMAPI.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>
